            </mxCell><mxCell id='12' value='HỘP 2: GỢI Ý VỊ TRÍ KỆ&lt;br&gt;Thuật toán quét vị trí còn chỗ:&lt;br&gt;Zone -&gt; Dãy Kệ -&gt; Tầng&lt;br&gt;(Ưu tiên kệ cùng SKU)' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
