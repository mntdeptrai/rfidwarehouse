              <mxGeometry x='350' y='355' width='240' height='80' as='geometry'/>
            </mxCell><mxCell id='13' value='Thủ kho đến từng vị trí kệ&lt;br&gt;Bóp cò PDA quét mã Pallet/Thùng&lt;br&gt;để xác nhận nhặt đúng kiện hàng' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F59E0B;strokeColor=#D97706;fontColor=#0F172A;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
