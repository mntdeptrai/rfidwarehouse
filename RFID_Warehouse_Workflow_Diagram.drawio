              <mxGeometry x='440' y='560' width='230' height='80' as='geometry'/>
            </mxCell><mxCell id='17' value='3. PHÂN LOẠI 4 NHÓM SAI LỆCH:&lt;br&gt;- [MATCH] Khớp đúng kệ (Xanh)&lt;br&gt;- [MISSING] Thiếu thực tế (Đỏ)&lt;br&gt;- [WRONG_LOC] Lạc vị trí (Cam)&lt;br&gt;- [UNKNOWN_EPC] Thẻ lạ (Tím)' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F59E0B;strokeColor=#D97706;fontColor=#0F172A;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='780' y='555' width='270' height='90' as='geometry'/>
            </mxCell><mxCell id='18' value='4. Đóng phiên &amp; Báo Cáo&lt;br&gt;Ghi inventory_session_details&lt;br&gt;Điều chỉnh chênh lệch (ADJUST)&lt;br&gt;Xuất báo cáo Excel kiểm kê' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
