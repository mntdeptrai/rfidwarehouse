      <root>
<mxCell id='0'/><mxCell id='1' parent='0'/><mxCell id='2' value='&lt;b&gt;1. SƠ ĐỒ NGHIỆP VỤ TOÀN DIỆN KHO THÔNG MINH RFID (MASTER BUSINESS FLOW)&lt;/b&gt;&lt;br&gt;&lt;small&gt;Quy trình khép kín: Nhập kho -&gt; Cổng RFID Gate -&gt; Cất kệ -&gt; Điều chuyển/Dồn pallet -&gt; Kiểm kê -&gt; Xuất FIFO -&gt; Giải phóng kệ&lt;/small&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#38BDF8;strokeWidth=2;fontSize=15;' vertex='1' parent='1'>
          <mxGeometry x='40' y='20' width='2520' height='55' as='geometry'/>
