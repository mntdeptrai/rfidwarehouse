  </diagram>  <diagram id='master_tab_2' name='3. QUY TRÌNH CẤT KỆ &amp; LƯU TR'>
    <mxGraphModel dx='1600' dy='900' grid='1' gridSize='10' guides='1' tooltips='1' connect='1' arrows='1' fold='1' page='1' pageScale='1' pageWidth='1800' pageHeight='980' math='0' shadow='0'>
      <root>
<mxCell id='0'/><mxCell id='1' parent='0'/><mxCell id='2' value='&lt;b&gt;3. QUY TRÌNH CẤT KỆ &amp; LƯU TRỮ VỊ TRÍ KHO (PDA PUTAWAY &amp; STORAGE FLOW)&lt;/b&gt;&lt;br&gt;&lt;small&gt;Luồng 2-hộp thao tác trên PDA: Quét Pallet/Thùng -&gt; Xem gợi ý kệ &amp; dẫn đường 2D -&gt; Quét Barcode Kệ -&gt; IN_STOCK&lt;/small&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#38BDF8;strokeWidth=2;fontSize=15;' vertex='1' parent='1'>
          <mxGeometry x='40' y='20' width='1720' height='55' as='geometry'/>
        </mxCell><mxCell id='3' value='&lt;b&gt;BƯỚC 1: TIẾP NHẬN TÁC VỤ &amp; NHẬN DIỆN KIỆN HÀNG (PDA Task Pickup)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='100' width='1720' height='180' as='geometry'/>
