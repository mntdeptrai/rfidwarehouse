              <mxGeometry x='780' y='350' width='230' height='75' as='geometry'/>
            </mxCell><mxCell id='14' value='4. Chuyển palletId thùng sang đích&lt;br&gt;Giải phóng pallet cũ nếu trống&lt;br&gt;Ghi nhận giao dịch dồn' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
