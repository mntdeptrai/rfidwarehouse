              <mxGeometry x='970' y='145' width='170' height='85' as='geometry'/>
            </mxCell><mxCell id='11' value='CẢNH BÁO VI PHẠM FIFO!&lt;br&gt;Có lô hàng cũ hơn chưa xuất&lt;br&gt;Yêu cầu lấy đúng lô đề xuất' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EF4444;strokeColor=#DC2626;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
