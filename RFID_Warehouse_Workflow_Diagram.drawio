            </mxCell><mxCell id='15' value='1. Tạo Phiên Kiểm Kê&lt;br&gt;Chọn Zone hoặc Kệ cụ thể&lt;br&gt;(inventory_sessions: created)' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8B5CF6;strokeColor=#7C3AED;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
