  </diagram>  <diagram id='master_tab_3' name='4. QUẢN LÝ KHO NỘI BỘ, ĐIỀU '>
    <mxGraphModel dx='1600' dy='900' grid='1' gridSize='10' guides='1' tooltips='1' connect='1' arrows='1' fold='1' page='1' pageScale='1' pageWidth='1800' pageHeight='980' math='0' shadow='0'>
      <root>
<mxCell id='0'/><mxCell id='1' parent='0'/><mxCell id='2' value='&lt;b&gt;4. QUẢN LÝ KHO NỘI BỘ, ĐIỀU CHUYỂN, DỒN PALLET &amp; KIỂM KÊ (INTERNAL &amp; AUDIT)&lt;/b&gt;&lt;br&gt;&lt;small&gt;4 phân hệ độc lập: Điều chuyển vị trí kệ, Dồn gộp Pallet, Kiểm kê RFID 4 nhóm &amp; Quản lý kệ 4-Tab&lt;/small&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#38BDF8;strokeWidth=2;fontSize=15;' vertex='1' parent='1'>
          <mxGeometry x='40' y='20' width='1720' height='55' as='geometry'/>
        </mxCell><mxCell id='3' value='&lt;b&gt;PHÂN HỆ A: ĐIỀU CHUYỂN VỊ TRÍ KỆ (Internal Location Transfer - pda_transfer_screen)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='100' width='1720' height='180' as='geometry'/>
            </mxCell><mxCell id='4' value='&lt;b&gt;PHÂN HỆ B: DỒN GỘP PALLET (Pallet Consolidation / Merge - pda_merge_pallets_screen)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#7DD3FC;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='300' width='1720' height='180' as='geometry'/>
            </mxCell><mxCell id='5' value='&lt;b&gt;PHÂN HỆ C: KIỂM KÊ RFID ĐỊNH KỲ (RFID Handheld Inventory Audit - 4 Variance Groups)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#D8B4FE;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='500' width='1720' height='210' as='geometry'/>
            </mxCell><mxCell id='6' value='&lt;b&gt;PHÂN HỆ D: QUẢN LÝ KHO 4-TAB &amp; BẢN ĐỒ 2D (Warehouse Management &amp; Floor Plan)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='730' width='1720' height='200' as='geometry'/>
            </mxCell><mxCell id='7' value='1. Quét mã Kệ Nguồn&lt;br&gt;(Hiển thị danh sách hàng tại kệ)' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='100' y='150' width='230' height='75' as='geometry'/>
            </mxCell><mxCell id='8' value='2. Quét / Chọn Kiện Hàng&lt;br&gt;hoặc Pallet cần di chuyển' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='440' y='150' width='230' height='75' as='geometry'/>
            </mxCell><mxCell id='9' value='3. Quét mã Kệ Đích&lt;br&gt;(Kiểm tra sức chứa kệ mới)' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#06B6D4;strokeColor=#0891B2;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='780' y='150' width='230' height='75' as='geometry'/>
            </mxCell><mxCell id='10' value='4. Cập nhật locationId mới&lt;br&gt;Ghi log Transaction: MOVE&lt;br&gt;Đồng bộ Supabase &amp; SQLite' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='1120' y='150' width='250' height='75' as='geometry'/>
