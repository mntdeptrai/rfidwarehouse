            </mxCell><mxCell id='9' value='Chạm thẻ hoặc quét Barcode&lt;br&gt;Pallet / Thùng hàng&lt;br&gt;(initialCartonOrPalletBarcode)' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
