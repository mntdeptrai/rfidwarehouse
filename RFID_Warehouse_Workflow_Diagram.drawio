  </diagram>  <diagram id='master_tab_4' name='5. QUY TRÌNH XUẤT KHO &amp; ĐỐI '>
    <mxGraphModel dx='1600' dy='900' grid='1' gridSize='10' guides='1' tooltips='1' connect='1' arrows='1' fold='1' page='1' pageScale='1' pageWidth='1800' pageHeight='980' math='0' shadow='0'>
      <root>
<mxCell id='0'/><mxCell id='1' parent='0'/><mxCell id='2' value='&lt;b&gt;5. QUY TRÌNH XUẤT KHO &amp; ĐỐI SOÁT FIFO CỔNG RFID (OUTBOUND FIFO PICKING &amp; GATE)&lt;/b&gt;&lt;br&gt;&lt;small&gt;Nguyên tắc FIFO nghiêm ngặt: Lô nhập cũ xuất trước -&gt; Wizard chỉ đường 10 kệ -&gt; Đối soát 2 pha -&gt; Giải phóng kệ&lt;/small&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#38BDF8;strokeWidth=2;fontSize=15;' vertex='1' parent='1'>
          <mxGeometry x='40' y='20' width='1720' height='55' as='geometry'/>
        </mxCell><mxCell id='3' value='&lt;b&gt;BƯỚC 1: TIẾP NHẬN ĐƠN XUẤT &amp; ĐỀ XUẤT FIFO (Outbound Order &amp; FIFO Algorithm)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#7DD3FC;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='100' width='1720' height='180' as='geometry'/>
            </mxCell><mxCell id='4' value='&lt;b&gt;BƯỚC 2: WIZARD CHỈ ĐƯỜNG LẤY HÀNG QUA CÁC KỆ (Picking Route Optimization)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='300' width='1720' height='190' as='geometry'/>
            </mxCell><mxCell id='5' value='&lt;b&gt;BƯỚC 3: ĐỐI SOÁT 2 PHA TẠI CỔNG RFID XUẤT / PDA (2-Phase Gate Verification)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6EE7B7;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='510' width='1720' height='220' as='geometry'/>
            </mxCell><mxCell id='6' value='&lt;b&gt;BƯỚC 4: GIẢI PHÓNG VỊ TRÍ KỆ &amp; GIAO HÀNG (Location Release &amp; Delivery Note)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#D8B4FE;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='750' width='1720' height='180' as='geometry'/>
            </mxCell><mxCell id='7' value='Tiếp nhận Yêu Cầu Xuất&lt;br&gt;(Đơn PO Khách Hàng)' style='rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='80' y='150' width='200' height='70' as='geometry'/>
            </mxCell><mxCell id='8' value='Khởi tạo Đơn Xuất Kho&lt;br&gt;outbound_orders (status: NEW)&lt;br&gt;outbound_order_details&lt;br&gt;(SKU, Số lượng yêu cầu)' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#06B6D4;strokeColor=#0891B2;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='350' y='150' width='220' height='75' as='geometry'/>
            </mxCell><mxCell id='9' value='THUẬT TOÁN ĐỐI SOÁT FIFO:&lt;br&gt;Truy vấn danh mục items IN_STOCK&lt;br&gt;Sắp xếp theo ngày nhập (created_at)&lt;br&gt;Ưu tiên tuyệt đối lô hàng nhập trước!' style='rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4338CA;fontColor=#FFFFFF;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='640' y='145' width='260' height='85' as='geometry'/>
