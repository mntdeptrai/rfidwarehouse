              <mxGeometry x='40' y='300' width='1720' height='200' as='geometry'/>
            </mxCell><mxCell id='5' value='&lt;b&gt;BƯỚC 3: DI CHUYỂN &amp; QUÉT XÁC NHẬN VỊ TRÍ KỆ ĐÍCH (Physical Location Scan)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6EE7B7;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='520' width='1720' height='200' as='geometry'/>
            </mxCell><mxCell id='6' value='&lt;b&gt;BƯỚC 4: XÁC NHẬN LƯU KHO &amp; ĐỒNG BỘ TOÀN HỆ THỐNG (Inventory Commit &amp; Sync)&lt;/b&gt;' style='swimlane;startSize=26;rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#D8B4FE;fontColor=#334155;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;' vertex='1' parent='1'>
              <mxGeometry x='40' y='740' width='1720' height='190' as='geometry'/>
            </mxCell><mxCell id='7' value='Thủ kho mở PDA&lt;br&gt;(pda_home_screen)' style='rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F59E0B;strokeColor=#D97706;fontColor=#0F172A;strokeWidth=2;fontSize=11;fontStyle=1;' vertex='1' parent='1'>
              <mxGeometry x='80' y='150' width='190' height='70' as='geometry'/>
