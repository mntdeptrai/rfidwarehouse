<Window x:Class="UHFDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="UHF RFID Desktop Professional Suite - Hopeland C# SDK 4.42 &amp; 105EN Edition" 
        Height="860" Width="1360"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">

    <Window.Resources>
        <!-- Dark Theme Industrial Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0B1120"/>
        <SolidColorBrush x:Key="CardDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardDarkHover" Color="#273549"/>
        <SolidColorBrush x:Key="CardDarkBorder" Color="#334155"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Control Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, sans-serif"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardDarkBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardDarkBorder}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#1E293B" CornerRadius="6,6,0,0" Padding="16,10" Margin="0,0,4,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" TextBlock.FontWeight="SemiBold" TextBlock.FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Connection Panel -->
            <RowDefinition Height="Auto"/> <!-- 2. KPI Dashboard -->
            <RowDefinition Height="*"/>    <!-- 3. Main Workspace Tabs -->
            <RowDefinition Height="150"/>  <!-- 4. System Console Log -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. HEADER ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CardDark}" CornerRadius="10" Padding="16,10" Margin="0,0,0,10" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="📡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="UHF RFID DESKTOP PROFESSIONAL SUITE" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentCyan}"/>
                            <Border Background="#065F46" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SDK v4.42 &amp; 105EN" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Hỗ trợ đầy đủ: Đa anten, Đọc/Ghi/Khóa/Hủy thẻ Gen2, GPIO Relay, LAN Search &amp; TCP Server" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hardware telemetry & Mode Switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌡️ Nhiệt độ: " FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtReaderTemp" Text="N/A" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Chế độ SDK:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="12"/>
                    <ComboBox x:Name="CmbSdkMode" Width="260" SelectionChanged="CmbSdkMode_SelectionChanged">
                        <ComboBoxItem Content="Hopeland RFIDReaderAPI.dll (Fixed / Network / COM)" IsSelected="True"/>
                        <ComboBoxItem Content="105EN SDK (USB Desktop Issuer Reader)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1. CONNECTION TOOLBAR ==================== -->
        <Border Grid.Row="1" Background="{StaticResource CardDark}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
            <Grid>
                <!-- Panel for RFIDReaderAPI Mode -->
                <Grid x:Name="PanelRfidReaderApi">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Giao thức:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondary}"/>
                        <ComboBox x:Name="CmbConnType" Width="130" SelectionChanged="CmbConnType_SelectionChanged">
                            <ComboBoxItem Content="TCP Client (IP)" IsSelected="True"/>
                            <ComboBoxItem Content="TCP Server"/>
                            <ComboBoxItem Content="Serial COM"/>
                            <ComboBoxItem Content="USB HID"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- TCP Client Options -->
                    <StackPanel x:Name="PanelTcpParams" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="IP Đầu đọc:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtIp" Text="192.168.1.116" Width="115" Margin="0,0,8,0"/>
                        <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtPort" Text="9090" Width="60"/>
                    </StackPanel>

                    <!-- TCP Server (Listener) Options -->
                    <StackPanel x:Name="PanelTcpServerParams" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed">
                        <TextBlock Text="Local IP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtServerIp" Text="0.0.0.0" Width="110" Margin="0,0,8,0"/>
                        <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtServerPort" Text="9090" Width="60"/>
                    </StackPanel>

                    <!-- Serial COM Options -->
                    <StackPanel x:Name="PanelSerialParams" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed">
                        <TextBlock Text="Cổng COM:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbComPorts" Width="95" Margin="0,0,6,0"/>
                        <Button x:Name="BtnRefreshCom" Content="🔄" Width="28" Padding="0" Background="{StaticResource CardDarkBorder}" Click="BtnRefreshCom_Click" Margin="0,0,8,0" ToolTip="Làm mới danh sách cổng COM"/>
                        <TextBlock Text="Baudrate:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbBaudRate" Width="95">
                            <ComboBoxItem Content="115200" IsSelected="True"/>
                            <ComboBoxItem Content="57600"/>
                            <ComboBoxItem Content="38400"/>
                            <ComboBoxItem Content="19200"/>
                            <ComboBoxItem Content="9600"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Connect Action Buttons -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button x:Name="BtnConnect" Content="🔗 KẾT NỐI ĐẦU ĐỌC" Background="{StaticResource AccentGreen}" Padding="16,6" Margin="0,0,8,0" Click="BtnConnect_Click"/>
                        <Button x:Name="BtnDisconnect" Content="NGẮT KẾT NỐI" Background="{StaticResource AccentRed}" Padding="12,6" IsEnabled="False" Margin="0,0,8,0" Click="BtnDisconnect_Click"/>
                        <Button x:Name="BtnQuickLanSearch" Content="🔍 TÌM THIẾT BỊ MẠNG" Background="{StaticResource CardDarkBorder}" Padding="12,6" Click="BtnQuickLanSearch_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Panel for 105EN Mode -->
                <Grid x:Name="Panel105En" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnAutoConnect105" Content="⚡ TỰ ĐỘNG TÌM &amp; KẾT NỐI 105EN" Background="{StaticResource AccentCyan}" Foreground="Black" Padding="14,6" Margin="0,0,14,0" Click="BtnAutoConnect105_Click"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Cổng COM:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbComPorts105" Width="90" Margin="0,0,6,0"/>
                        <TextBlock Text="Baud:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbBaudRate105" Width="85">
                            <ComboBoxItem Content="57600" IsSelected="True"/>
                            <ComboBoxItem Content="115200"/>
                            <ComboBoxItem Content="38400"/>
                            <ComboBoxItem Content="9600"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="BtnBeepTest" Grid.Column="2" Content="🔔 Test Buzzer" Background="{StaticResource CardDarkBorder}" Padding="10,6" Margin="0,0,10,0" Click="BtnBeepTest_Click"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button x:Name="BtnConnect105" Content="KẾT NỐI THỦ CÔNG" Background="{StaticResource AccentGreen}" Padding="14,6" Margin="0,0,8,0" Click="BtnConnect105_Click"/>
                        <Button x:Name="BtnDisconnect105" Content="NGẮT KẾT NỐI" Background="{StaticResource AccentRed}" Padding="12,6" IsEnabled="False" Click="BtnDisconnect105_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 2. KPI DASHBOARD ==================== -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Unique Tags -->
            <Border Grid.Column="0" Background="{StaticResource CardDark}" CornerRadius="10" Padding="14,8" Margin="0,0,6,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SỐ THẺ DUY NHẤT" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUniqueCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🏷️" FontSize="26" VerticalAlignment="Center" Opacity="0.5"/>
                </Grid>
            </Border>

            <!-- KPI 2: Total Reads -->
            <Border Grid.Column="1" Background="{StaticResource CardDark}" CornerRadius="10" Padding="14,8" Margin="3,0,3,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TỔNG LƯỢT ĐỌC" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtTotalReads" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="📊" FontSize="26" VerticalAlignment="Center" Opacity="0.5"/>
                </Grid>
            </Border>

            <!-- KPI 3: Read Rate -->
            <Border Grid.Column="2" Background="{StaticResource CardDark}" CornerRadius="10" Padding="14,8" Margin="3,0,3,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TỐC ĐỘ QUÉT (TAGS/S)" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtReadRate" Text="0/s" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="⚡" FontSize="26" VerticalAlignment="Center" Opacity="0.5"/>
                </Grid>
            </Border>

            <!-- KPI 4: Connection & Scan Status -->
            <Border Grid.Column="3" Background="{StaticResource CardDark}" CornerRadius="10" Padding="14,8" Margin="6,0,0,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TRẠNG THÁI HỆ THỐNG" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtReaderStatus" Text="DISCONNECTED" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentRed}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="LedStatus" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Background="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. MAIN WORKSPACE TABS ==================== -->
        <TabControl x:Name="MainTabs" Grid.Row="3" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardDarkBorder}" Margin="0,0,0,10">

            <!-- ==================== TAB 1: LIVE INVENTORY ==================== -->
            <TabItem Header="📡 Quét Thẻ (Live Inventory)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Antenna & Scan Options -->
                        <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Tag DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- 1. Antenna Matrix & Options Bar -->
                    <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Cổng Anten:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentCyan}"/>
                                <CheckBox x:Name="ChkAnt1" Content="ANT 1" IsChecked="True" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ChkAnt2" Content="ANT 2" IsChecked="False" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ChkAnt3" Content="ANT 3" IsChecked="False" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ChkAnt4" Content="ANT 4" IsChecked="False" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ChkAnt5" Content="ANT 5" IsChecked="False" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ChkAnt6" Content="ANT 6" IsChecked="False" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ChkAnt7" Content="ANT 7" IsChecked="False" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ChkAnt8" Content="ANT 8" IsChecked="False" Margin="0,0,12,0"/>
                                <Button Content="Chọn tất cả" Background="{StaticResource CardDarkBorder}" Padding="6,2" FontSize="11" Click="BtnSelectAllAnt_Click" Margin="0,0,4,0"/>
                                <Button Content="Bỏ chọn" Background="{StaticResource CardDarkBorder}" Padding="6,2" FontSize="11" Click="BtnDeselectAllAnt_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Chế độ quét:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondary}"/>
                                <ComboBox x:Name="CmbScanMode" Width="170" Margin="0,0,10,0">
                                    <ComboBoxItem Content="Chỉ mã EPC (Nhanh nhất)" IsSelected="True"/>
                                    <ComboBoxItem Content="Đồng thời EPC + TID"/>
                                    <ComboBoxItem Content="EPC + TID + User Data"/>
                                    <ComboBoxItem Content="Full Memory All-in-One"/>
                                </ComboBox>
                                <CheckBox x:Name="ChkSoundBeep" Content="🔔 Âm bíp" IsChecked="True" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Action Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnStartInventory" Content="▶ BẮT ĐẦU QUÉT" Background="{StaticResource AccentGreen}" Padding="18,8" FontWeight="Bold" Margin="0,0,8,0" Click="BtnStartInventory_Click"/>
                        <Button x:Name="BtnStopInventory" Grid.Column="1" Content="⏹ DỪNG QUÉT" Background="{StaticResource AccentRed}" Padding="18,8" FontWeight="Bold" Margin="0,0,8,0" IsEnabled="False" Click="BtnStopInventory_Click"/>
                        <Button x:Name="BtnClearList" Grid.Column="2" Content="🧹 Xóa danh sách" Background="{StaticResource CardDarkBorder}" Padding="12,8" Click="BtnClearList_Click"/>

                        <!-- Search Filter -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,10,0">
                            <TextBlock Text="🔍 Tìm thẻ:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtSearchEpc" Width="200" TextChanged="TxtSearchEpc_TextChanged" ToolTip="Tìm theo EPC hoặc TID"/>
                        </StackPanel>

                        <Button x:Name="BtnExportCsv" Grid.Column="5" Content="📥 Xuất File CSV" Background="{StaticResource AccentBlue}" Padding="14,8" Click="BtnExportCsv_Click"/>
                    </Grid>

                    <!-- 3. Tag DataGrid -->
                    <DataGrid x:Name="DgTags" Grid.Row="2" AutoGenerateColumns="False" 
                              Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#162032"
                              Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardDarkBorder}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardDarkBorder}"
                              IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgTags_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#1E293B" Foreground="White">
                                <MenuItem Header="📋 Sao chép mã EPC" Click="MenuCopyEpc_Click"/>
                                <MenuItem Header="📋 Sao chép mã TID" Click="MenuCopyTid_Click"/>
                                <Separator Background="{StaticResource CardDarkBorder}"/>
                                <MenuItem Header="✍️ Đưa vào bộ Đọc / Ghi thẻ" Click="MenuSendToRw_Click"/>
                                <MenuItem Header="🔒 Đưa vào bộ Khóa / Hủy thẻ" Click="MenuSendToLock_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="50"/>
                            <DataGridTextColumn Header="Mã EPC (Electronic Product Code)" Binding="{Binding EPC}" Width="280" FontFamily="Consolas" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Mã TID (Tag Identifier)" Binding="{Binding TID}" Width="220" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Cường độ RSSI" Binding="{Binding RssiDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Anten" Binding="{Binding Antenna}" Width="65"/>
                            <DataGridTextColumn Header="Số lần đọc" Binding="{Binding Count}" Width="85" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tần số (MHz)" Binding="{Binding Frequency}" Width="100"/>
                            <DataGridTextColumn Header="Góc pha" Binding="{Binding Phase}" Width="80"/>
                            <DataGridTextColumn Header="Lần cuối thấy" Binding="{Binding LastSeenString}" Width="120"/>
                            <DataGridTextColumn Header="Bộ nhớ User" Binding="{Binding UserData}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 2: READ / WRITE & COMMISSIONING ==================== -->
            <TabItem Header="✍️ Đọc &amp; Ghi Thẻ (Memory R/W)">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Memory Bank R/W -->
                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ĐỌC &amp; GHI VÙNG NHỚ CHI TIẾT (ISO 18000-6C)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,14"/>

                            <TextBlock Text="1. Chọn Vùng nhớ (Memory Bank):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <ComboBox x:Name="CmbRwBank" Margin="0,0,0,10">
                                <ComboBoxItem Content="1: EPC (Electronic Product Code)" IsSelected="True"/>
                                <ComboBoxItem Content="2: TID (Tag Identifier - Chỉ đọc)"/>
                                <ComboBoxItem Content="3: USER (Bộ nhớ dữ liệu người dùng)"/>
                                <ComboBoxItem Content="0: RESERVED (Mật khẩu Kill &amp; Access)"/>
                            </ComboBox>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Địa chỉ bắt đầu (Word Offset):" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtRwOffset" Text="2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Độ dài từ (Word Count):" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtRwCount" Text="6"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Mật khẩu truy cập (Access Password - 8 Hex chars):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtRwPassword" Text="00000000" FontFamily="Consolas" Margin="0,0,0,10"/>

                            <TextBlock Text="Mã EPC lọc thẻ đích (Tùy chọn - Trống = thẻ gần nhất):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtRwMatchEpc" FontFamily="Consolas" Margin="0,0,0,10"/>

                            <TextBlock Text="Dữ liệu Hex (Ghi dữ liệu hoặc Kết quả đọc):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtRwData" Height="65" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnReadData" Content="📥 ĐỌC DỮ LIỆU" Background="{StaticResource AccentCyan}" Foreground="Black" Padding="16,8" Margin="0,0,10,0" Click="BtnReadData_Click"/>
                                <Button x:Name="BtnWriteData" Content="📤 GHI DỮ LIỆU" Background="{StaticResource AccentGreen}" Padding="16,8" Click="BtnWriteData_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right: Fast EPC Rewriter -->
                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="16" Margin="10,0,0,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="GHI ĐÈ EPC SIÊU TỐC (FAST EPC COMMISSIONING)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,14"/>

                            <TextBlock Text="Mã EPC thẻ cần đổi (Chọn từ danh sách quét hoặc nhập):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtTargetEpc" FontFamily="Consolas" Margin="0,0,0,10"/>

                            <TextBlock Text="Mã EPC MỚI cần ghi (24 ký tự Hex = 96 bit):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtNewEpc" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,0,10,0"/>

                            <Button x:Name="BtnGenRandomEpc" Content="🎲 Tạo EPC Ngẫu nhiên" Background="{StaticResource CardDarkBorder}" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,14" Click="BtnGenRandomEpc_Click"/>

                            <Button x:Name="BtnQuickWriteEpc" Content="⚡ GHI ĐÈ EPC MỚI NGAY" Background="{StaticResource AccentGreen}" Padding="16,10" FontWeight="Bold" FontSize="14" Margin="0,0,0,16" Click="BtnQuickWriteEpc_Click"/>

                            <Border Background="#1E293B" CornerRadius="6" Padding="12" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="💡 Hướng dẫn nhanh:" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Mã EPC tiêu chuẩn Gen2 có độ dài 96 bits = 24 ký tự Hex (0-9, A-F)." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="• Chọn thẻ trong bảng Quét Thẻ -> Nhấp chuột phải -> 'Đưa vào bộ Đọc/Ghi'." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 3: TAG SECURITY (LOCK / KILL) ==================== -->
            <TabItem Header="🔒 Bảo Mật Thẻ (Lock &amp; Kill)">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lock Tag Panel -->
                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="KHÓA VÙNG NHỚ THẺ (TAG MEMORY LOCK)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentAmber}" Margin="0,0,0,14"/>

                            <TextBlock Text="Mã EPC thẻ cần khóa:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtLockTargetEpc" FontFamily="Consolas" Margin="0,0,0,10"/>

                            <TextBlock Text="Vùng nhớ cần áp dụng khóa:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <ComboBox x:Name="CmbLockArea" Margin="0,0,0,10">
                                <ComboBoxItem Content="User Memory" IsSelected="True"/>
                                <ComboBoxItem Content="TID Memory"/>
                                <ComboBoxItem Content="EPC Memory"/>
                                <ComboBoxItem Content="Access Password"/>
                                <ComboBoxItem Content="Kill Password"/>
                            </ComboBox>

                            <TextBlock Text="Thao tác khóa (Lock Action):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <ComboBox x:Name="CmbLockType" Margin="0,0,0,10">
                                <ComboBoxItem Content="0: Mở khóa (Unlock)" IsSelected="True"/>
                                <ComboBoxItem Content="1: Khóa tạm (Lock)"/>
                                <ComboBoxItem Content="2: Mở khóa vĩnh viễn (Permanent Unlock)"/>
                                <ComboBoxItem Content="3: Khóa vĩnh viễn không thể sửa (Permanent Lock)"/>
                            </ComboBox>

                            <TextBlock Text="Mật khẩu truy cập (Access Password):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtLockPassword" Text="00000000" FontFamily="Consolas" Margin="0,0,0,14"/>

                            <Button x:Name="BtnApplyLock" Content="🔒 THIẾT LẬP KHÓA THẺ" Background="{StaticResource AccentAmber}" Foreground="Black" Padding="16,8" FontWeight="Bold" Click="BtnApplyLock_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Kill Tag Panel -->
                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="16" Margin="10,0,0,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="HỦY THẺ VĨNH VIỄN (TAG DESTROY / KILL)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentRed}" Margin="0,0,0,14"/>

                            <Border Background="#450A0A" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#991B1B" BorderThickness="1">
                                <TextBlock Text="⚠️ CẢNH BÁO: Lệnh Kill sẽ vô hiệu hóa chip RFID vĩnh viễn không thể phục hồi! Chỉ sử dụng khi thanh lý tài sản." Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="11"/>
                            </Border>

                            <TextBlock Text="Mã EPC thẻ cần hủy:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtKillTargetEpc" FontFamily="Consolas" Margin="0,0,0,10"/>

                            <TextBlock Text="Mật khẩu hủy (Kill Password - 8 Hex chars):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtKillPassword" Text="00000000" FontFamily="Consolas" Margin="0,0,0,16"/>

                            <Button x:Name="BtnKillTag" Content="💥 HỦY THẺ VĨNH VIỄN (KILL TAG)" Background="{StaticResource AccentRed}" Padding="16,10" FontWeight="Bold" FontSize="13" Click="BtnKillTag_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 4: RF POWER & FREQUENCY ==================== -->
            <TabItem Header="⚡ Công Suất &amp; Tần Số (RF Config)">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Antenna Power Matrix -->
                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CÔNG SUẤT PHÁT SÓNG ĐỘC LẬP TỪNG ANTEN (dBm)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ANTEN 1:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <Slider x:Name="SliderPower1" Grid.Column="1" Minimum="1" Maximum="33" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" ValueChanged="SliderPower_ValueChanged"/>
                                <TextBlock x:Name="TxtPower1" Grid.Column="2" Text="30 dBm" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ANTEN 2:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <Slider x:Name="SliderPower2" Grid.Column="1" Minimum="1" Maximum="33" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" ValueChanged="SliderPower_ValueChanged"/>
                                <TextBlock x:Name="TxtPower2" Grid.Column="2" Text="30 dBm" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ANTEN 3:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <Slider x:Name="SliderPower3" Grid.Column="1" Minimum="1" Maximum="33" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" ValueChanged="SliderPower_ValueChanged"/>
                                <TextBlock x:Name="TxtPower3" Grid.Column="2" Text="30 dBm" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ANTEN 4:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <Slider x:Name="SliderPower4" Grid.Column="1" Minimum="1" Maximum="33" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" ValueChanged="SliderPower_ValueChanged"/>
                                <TextBlock x:Name="TxtPower4" Grid.Column="2" Text="30 dBm" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="BtnApplyAllPower" Content="⚡ ÁP DỤNG CÔNG SUẤT TẤT CẢ ANTEN" Background="{StaticResource AccentAmber}" Foreground="Black" Padding="14,8" FontWeight="Bold" Margin="0,0,8,0" Click="BtnApplyAllPower_Click"/>
                                <Button x:Name="BtnQueryPower" Content="🔄 Đọc công suất hiện tại" Background="{StaticResource CardDarkBorder}" Padding="12,8" Click="BtnQueryPower_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right: Frequency Band & Gen2 BaseBand -->
                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="16" Margin="10,0,0,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="BĂNG TẦN &amp; THÔNG SỐ GEN2 BASEBAND" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,14"/>

                            <TextBlock Text="Băng tần làm việc (Frequency Standard):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <ComboBox x:Name="CmbFrequencyBand" Margin="0,0,0,10">
                                <ComboBoxItem Content="Mỹ / Quốc tế: US FCC (902.75 - 927.25 MHz)" IsSelected="True"/>
                                <ComboBoxItem Content="Châu Âu: EU ETSI (865.7 - 868.1 MHz)"/>
                                <ComboBoxItem Content="Trung Quốc / Châu Á: China (920.625 - 924.375 MHz)"/>
                                <ComboBoxItem Content="Tự động nhảy tần (Auto Frequency Hopping)"/>
                            </ComboBox>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Gen2 Session:" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="CmbSession">
                                        <ComboBoxItem Content="S0 (Nhanh / 1 Anten)" IsSelected="True"/>
                                        <ComboBoxItem Content="S1 (Chống lặp)"/>
                                        <ComboBoxItem Content="S2 (Hàng rào cổng)"/>
                                        <ComboBoxItem Content="S3 (Đa anten)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Target Flag:" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="CmbTarget">
                                        <ComboBoxItem Content="Target A" IsSelected="True"/>
                                        <ComboBoxItem Content="Target B"/>
                                        <ComboBoxItem Content="Target A / B Toggle"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnApplyBaseBand" Content="Áp dụng cấu hình Gen2 Baseband" Background="{StaticResource AccentPurple}" Padding="14,8" Margin="0,0,0,12" Click="BtnApplyBaseBand_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 5: GPIO & INDUSTRIAL CONTROL ==================== -->
            <TabItem Header="🚦 GPIO &amp; Điều Khiển Rơ-le">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: GPI Inputs Monitoring -->
                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="GIÁM SÁT TÍN HIỆU ĐẦU VÀO GPI (CẢM BIẾN)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="LedGpi1" Width="18" Height="18" CornerRadius="9" Background="#475569" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Cổng GPI 1" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtGpi1State" Text="LOW (Không tích cực)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="LedGpi2" Width="18" Height="18" CornerRadius="9" Background="#475569" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Cổng GPI 2" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtGpi2State" Text="LOW (Không tích cực)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="LedGpi3" Width="18" Height="18" CornerRadius="9" Background="#475569" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Cổng GPI 3" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtGpi3State" Text="LOW (Không tích cực)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="LedGpi4" Width="18" Height="18" CornerRadius="9" Background="#475569" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Cổng GPI 4" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtGpi4State" Text="LOW (Không tích cực)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Button x:Name="BtnRefreshGpi" Content="🔄 Đọc trạng thái GPI hiện tại" Background="{StaticResource CardDarkBorder}" Padding="12,8" Click="BtnRefreshGpi_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: GPO Outputs Relay Control -->
                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="16" Margin="10,0,0,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ĐIỀU KHIỂN ĐẦU RA GPO (RƠ-LE / ĐÈN BÁO / CÒI)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentAmber}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GPO 1 (Rơ-le 1 / Dự phòng)" FontWeight="Bold"/>
                                    <TextBlock Text="Tín hiệu điều khiển phụ trợ hoặc Còi" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔵 BẬT" Background="{StaticResource AccentBlue}" Padding="10,4" Margin="0,0,6,0" Click="BtnGpo1On_Click"/>
                                    <Button Content="⚪ TẮT" Background="{StaticResource CardDarkBorder}" Padding="10,4" Click="BtnGpo1Off_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GPO 2 (L4 - Đèn VÀNG)" FontWeight="Bold"/>
                                    <TextBlock Text="Cảnh báo sự cố / Lỗi hệ thống" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🟡 BẬT" Background="{StaticResource AccentAmber}" Foreground="Black" Padding="10,4" Margin="0,0,6,0" Click="BtnGpo2On_Click"/>
                                    <Button Content="⚪ TẮT" Background="{StaticResource CardDarkBorder}" Padding="10,4" Click="BtnGpo2Off_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GPO 3 (L3 - Đèn XANH) &amp; GPO 4 (L2 - Đèn ĐỎ)" FontWeight="Bold"/>
                                    <TextBlock Text="GPO 3 = Đủ hàng (Xanh) | GPO 4 = Sai/Thiếu hàng (Đỏ)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Bật tất cả" Background="{StaticResource AccentAmber}" Foreground="Black" Padding="10,4" Margin="0,0,6,0" Click="BtnGpoAllOn_Click"/>
                                    <Button Content="Tắt tất cả" Background="{StaticResource CardDarkBorder}" Padding="10,4" Click="BtnGpoAllOff_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 6: LAN SEARCH & DEVICE MANAGER ==================== -->
            <TabItem Header="🌐 Tìm Thiết Bị LAN &amp; Quản Lý">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action bar -->
                        <RowDefinition Height="180"/>  <!-- Discovered devices grid -->
                        <RowDefinition Height="*"/>    <!-- Network configuration -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSearchLanDevices" Content="🔍 TÌM KIẾM ĐẦU ĐỌC TRONG MẠNG LAN" Background="{StaticResource AccentCyan}" Foreground="Black" Padding="16,8" FontWeight="Bold" Margin="0,0,10,0" Click="BtnSearchLanDevices_Click"/>
                            <Button x:Name="BtnStopSearchLan" Content="⏹ Dừng tìm kiếm" Background="{StaticResource CardDarkBorder}" Padding="12,8" Click="BtnStopSearchLan_Click"/>
                        </StackPanel>
                        <Button x:Name="BtnConnectSelectedDevice" Grid.Column="1" Content="🔗 Kết nối thiết bị được chọn" Background="{StaticResource AccentGreen}" Padding="16,8" FontWeight="Bold" Click="BtnConnectSelectedDevice_Click"/>
                    </Grid>

                    <!-- Device DataGrid -->
                    <DataGrid x:Name="DgDiscoveredDevices" Grid.Row="1" AutoGenerateColumns="False" 
                              Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#162032"
                              Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardDarkBorder}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardDarkBorder}"
                              IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,12" MouseDoubleClick="DgDiscoveredDevices_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Địa chỉ IP" Binding="{Binding IP}" Width="130" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            <DataGridTextColumn Header="Địa chỉ MAC" Binding="{Binding MAC}" Width="150" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Subnet Mask" Binding="{Binding Mask}" Width="120"/>
                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="120"/>
                            <DataGridTextColumn Header="Server Port" Binding="{Binding ServerPort}" Width="90"/>
                            <DataGridTextColumn Header="Chế độ hoạt động" Binding="{Binding WorkingMode}" Width="120"/>
                            <DataGridTextColumn Header="Loại thiết bị" Binding="{Binding DeviceType}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Network & Device Management Panel -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Change IP Config -->
                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,8,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CẤU HÌNH MẠNG ĐẦU ĐỌC (IP / SUBNET / GATEWAY)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10"/>

                                <TextBlock Text="Địa chỉ IP mới:" Margin="0,0,0,2" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtNetConfigIp" Text="192.168.1.116" Margin="0,0,0,6"/>

                                <TextBlock Text="Subnet Mask:" Margin="0,0,0,2" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtNetConfigMask" Text="255.255.255.0" Margin="0,0,0,6"/>

                                <TextBlock Text="Default Gateway:" Margin="0,0,0,2" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtNetConfigGateway" Text="192.168.1.1" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnSaveNetConfig" Content="LƯU CẤU HÌNH IP" Background="{StaticResource AccentBlue}" Padding="14,6" Margin="0,0,8,0" Click="BtnSaveNetConfig_Click"/>
                                    <Button x:Name="BtnGetNetConfig" Content="Đọc cấu hình hiện tại" Background="{StaticResource CardDarkBorder}" Padding="12,6" Click="BtnGetNetConfig_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Reader Diagnostics & Soft Reset -->
                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="14" Margin="8,0,0,0" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN THIẾT BỊ &amp; KHỞI ĐỘNG LẠI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentAmber}" Margin="0,0,0,10"/>

                                <TextBlock Text="Thông tin Firmware &amp; Model:" Margin="0,0,0,2" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtDeviceInfo" Height="50" TextWrapping="Wrap" IsReadOnly="True" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnGetDeviceInfo" Content="📋 Đọc thông tin thiết bị" Background="{StaticResource CardDarkBorder}" Padding="12,6" Margin="0,0,8,0" Click="BtnGetDeviceInfo_Click"/>
                                    <Button x:Name="BtnResetReader" Content="🔄 Khởi động lại đầu đọc (Soft Reset)" Background="{StaticResource AccentRed}" Padding="12,6" Click="BtnResetReader_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== 4. SYSTEM LOG CONSOLE ==================== -->
        <Border Grid.Row="4" Background="{StaticResource CardDark}" CornerRadius="10" Padding="10" BorderBrush="{StaticResource CardDarkBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋 NHẬT KÝ HOẠT ĐỘNG (SYSTEM LOG):" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="ChkAutoScrollLog" Content="Tự cuộn" IsChecked="True" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Xóa Log" Background="{StaticResource CardDarkBorder}" Padding="8,2" FontSize="11" Click="BtnClearLog_Click"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="TxtLogConsole" Grid.Row="1" Background="#060A12" Foreground="{StaticResource AccentCyan}" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
